# Copy these into Vercel → Project → Settings → Environment Variables.
# Never commit real keys.

# Stripe secret key. sk_test_… while testing, sk_live_… in production.
STRIPE_SECRET_KEY=sk_test_replace_me

# Canonical site URL, used to build the checkout return links.
SITE_URL=https://www.vitas.com.hk

# ---------------------------------------------------------------- PayMe (HSBC)
# From the PayMe for Business credentials sheet. Sandbox and live have separate sets.
PAYME_ENV=sandbox
PAYME_CLIENT_ID=
PAYME_CLIENT_SECRET=
PAYME_SIGNING_KEY_ID=
PAYME_SIGNING_KEY=

# Order storage: Upstash Redis from the Vercel Marketplace sets these for you
# (KV_REST_API_URL, KV_REST_API_TOKEN). Nothing to add by hand.

# Order emails via Resend. The domain must be verified in Resend.
RESEND_API_KEY=
# Optional: MAIL_FROM="VITAS 紓適寧 <info@vitas.com.hk>"  NOTIFY_EMAIL=info@vitas.com.hk
